  checkNumericalStability         false     ; 是否检查数值稳定性
}

mpc
{
  timeHorizon                     1.0  ; 预测时域[s]（2026-11-05 由 0.5 恢复到 1.0：0.5 不到两个步态相位，MPC 不会把脚往前放，仿真前进只跟上 18%；OCS2 已改回 Release，求解中位约 4 ms）
  solutionTimeWindow              -1   ; 求解时间上限[s]，-1=不限
