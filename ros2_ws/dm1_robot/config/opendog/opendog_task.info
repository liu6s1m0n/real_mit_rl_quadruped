    forward          0.18
    forward_fast     0.36
    backward         0.18       ; 2026-11-06 由 0.30 降低：实机三段后退都出现 ±6° 俯仰，其中一次摔倒；与前进同档
    lateral          0.15       ; 2026-11-09 由 0.20 降低：横移力矩需求大，电池过载
    yaw_rate         0.20       ; 2026-11-09 由 0.30 降低：同上
}

