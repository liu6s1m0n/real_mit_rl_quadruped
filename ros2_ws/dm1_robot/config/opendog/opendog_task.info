centroidalModelType             0      ; 动力学模型：0=完整质心，1=单刚体

hardware_output
{
  ; 原 OpenDog 统一增益为 kp=4、kd=5。
  ; 2026-11-09 先统一为 kp=8、kd=5（原为 kp 17、后腿 KFE 18），同日按用户要求改回原 OpenDog 的 kp=4、kd=5。
  ; q_des 取 MPC 当前时刻状态，约等于 q，kp 项在踏步中几乎为 0，主要影响趴卧/站起插值和受扰回复。
  ; KFE 的四个独立参数保留但取相同值。
  kp                  4.0     ; HAA/HFE 位置跟踪增益
  kd                  5.0
                              ; kd 已是达妙 MIT 协议上限 5（kKdMax），不能再提高，超过会被整帧拒发。
  FR_calf_kp          4.0     ; 右前 KFE 位置增益
  FL_calf_kp          4.0     ; 左前 KFE 位置增益
  RR_calf_kp          4.0     ; 右后 KFE 位置增益（11/02 试过 30，姿态无改善）
  RL_calf_kp          4.0     ; 左后 KFE 位置增益
  ; 关节库仑摩擦补偿（2026-11-09）：前馈力矩加 torque·tanh(dq_des / velocity)。WBC 模型不含关节摩擦，
  ; 仿真给每个关节加 1.2 Nm 摩擦后能复现实机的对角 roll 摇摆（每相 ±0.7°）。0 表示不补偿；
  ; 无摩擦时补偿过量也会引起摇摆，按 0.5 → 1.0 逐步加。
  frictionCompensation
  {
    torque            1.5     ; N·m（11-09：0.5→1.0 实机 roll σ 0.71→0.60→0.46°；每相摇摆仍 ±0.9°、滞后 150 ms，与仿真摩擦 2.0 Nm 时一致，加到 1.5）
    velocity          0.15    ; rad/s，|dq_des| 远大于此值时补满。零速附近斜率 torque/velocity 不能超过约 10：
                              ; 11-09 实机 1.5/0.1=15 时站立自激振荡，1.0/0.1=10 稳定；只在踏步模式下补偿，且只补计划支撑的腿
  }
}

; 真实触地检测（2026-11-09 新增）：11-09 实机后腿比计划晚落地 20–35 ms，计划支撑时脚还在空中，
; 机尾下沉，着地后 30 ms 内 WBC 竖直力冲到约 100 N。计划进入支撑后，足端竖直力超过 forceThreshold，
; 或足端离地面估计不到 heightThreshold 且竖直速度高于 -velocityThreshold（heightThreshold 为 0 时不用），连续 confirmTicks 个周期即判为触地；
; 超过 maxDelay 仍未满足也按触地处理。只在踏步模式下判断。
; mode：0 关闭（触地=计划）；1 影子，只把结果写入 CSV 的 opendog_*_contact_detected，不影响控制；
;       2 参与控制：估计器和 WBC 按检测结果，计划支撑但未触地的腿按摆腿处理并以 probeVelocity 继续下探，
;       WBC 落地力缓升从真实触地开始。实机离线数据里各信号不够干净，先用 1 收集数据定阈值，再改 2。
contactDetection
{
  mode                1
  rearOnly            1         ; 只检测两条后腿（前腿实机基本准时落地，落地初期承重小，力信号太弱）
  forceThreshold      30.0      ; N，实机后腿计划落地后反推竖直力先为负、约 +20 ms 起超过 30 N
  heightThreshold     0.0       ; m，0 关闭高度/速度条件：毫米级分不清“将落未落”和“刚落地”，仿真里会提前误判
  velocityThreshold   0.05      ; m/s
  confirmTicks        2
  maxDelay            0.06      ; s
  probeVelocity       0.10      ; m/s
}

