; Q：状态误差权重矩阵
; 2026-11-05 按源码 legged_mujoco/config/dmgo/task.info 的比例整体重设，以基座位置 x 为基准统一乘 0.95。
; 原配置的关节、姿态权重是源码比例的 4～70 倍，会把腿锁在默认姿态附近：仿真中前进只跟上 18%、左移 5%；
; 按源码比例后前进 92%、左移 80%，原地踏步基本不漂，后腿髋外展由约 8° 降到约 3°，站高仍为 0.32 m。
Q
{
  scaling 1e+0                     ; Q矩阵整体缩放

  ;; 归一化质心动量权重 ;;
  (0,0)   14.25    ; 质心线速度x
  (1,1)   14.25    ; 质心线速度y
  (2,2)   95.0     ; 质心线速度z
  ;; 2026-11-06 姿态/偏航：285 → 2000 让实机原地 roll/pitch σ 从 1.05° 降到 0.6°，但 MPC 规划的
  ;; 水平力从 Fz 的 0.146 涨到 0.191（超出摩擦 0.3 的时间 8.8% → 20%），支撑脚每相打滑 0.6 cm，
  ;; 表现为随步态的偏航扭动（峰峰 11°）。退到中间档 1000、角动量 30/60，偏航 95 → 500、
  ;; 角动量 z 28.5 → 45，并把摩擦系数收到 0.25。
  (3,3)   30.0     ; 归一化角动量x
  (4,4)   60.0     ; 归一化角动量y
  (5,5)   45.0     ; 归一化角动量z

  ;; 基座位姿权重 ;;
  (6,6)   950.0    ; 基座位置x
  (7,7)   950.0    ; 基座位置y
  (8,8)   1425.0   ; 基座位置z
  (9,9)   500.0    ; 基座姿态z
  (10,10) 1000.0   ; 基座姿态y
  (11,11) 1000.0   ; 基座姿态x

  ;; 腿部关节位置权重：HAA : HFE : KFE = 2 : 2 : 1（源码比例）。默认关节角已按站高 0.32 重算，
  ;; 降低关节权重不会再像 11-04 那样掉站高 ;;
  (12,12)  4.75     ; 左前HAA
  (13,13)  4.75     ; 左前HFE
  (14,14)  2.375    ; 左前KFE
  (15,15)  4.75     ; 左后HAA
  (16,16)  4.75     ; 左后HFE
  (17,17)  2.375    ; 左后KFE
  (18,18)  4.75     ; 右前HAA
  (19,19)  4.75     ; 右前HFE
  (20,20)  2.375    ; 右前KFE
  (21,21)  4.75     ; 右后HAA
  (22,22)  4.75     ; 右后HFE
  (23,23)  2.375    ; 右后KFE
}

