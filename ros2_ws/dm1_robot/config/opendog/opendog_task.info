; 全身控制
; WBC 力矩上限（2026-11-09 由机械峰值 97 改为 30，与硬件默认 --torque-limit 30 一致，源码 dmgo 为 33.5）：
; WBC 在上限内重新分配，避免规划出的超额力矩在发送端被按比例截断。
torqueLimitsTask
{
   (0,0)  30.0     ; HAA最大力矩[Nm]
   (1,0)  30.0     ; HFE最大力矩[Nm]
   (2,0)  30.0     ; KFE最大力矩[Nm]
}

frictionConeTask
{
  frictionCoefficient    0.25      ; 摩擦系数（2026-11-06 由 0.3 收紧：实机支撑脚打滑）
}

swingLegTask
{
    kp                   350       ; 摆腿任务位置增益，不改变底层电机 PD（2026-11-09 恢复 10-27 首版与源码 dmgo 的 350；11-01 曾提高到 450）
    kd                   37        ; 原 OpenDog 摆腿速度增益
}

; 落地力缓升（2026-11-09 新增）：刚进入支撑的腿，WBC 竖直接触力不超过 比例×MPC 期望竖直力，
; 比例在 duration 内从 initialRatio 线性升到 1。实机落地瞬间 WBC 竖直力 95% 分位约为 MPC 的 1.9 倍、IMU 竖直冲击约 3 g。
; 删去本段或 duration 设为 0 即恢复原行为。
contactForceRamp
{
    duration             0.05      ; 缓升时长[s]（2026-11-09 由 0.03 加长：仿真落地后力矩 95% 分位 11.9→8.3 Nm）
    initialRatio         0.2       ; 落地瞬间允许的竖直力比例（由 0.3 降低）
}

weight
{
    swingLeg        12              ; 保留摆腿可执行性，同时降低其对躯干稳定的竞争
    baseAccel       5.0             ; 将躯干加速度修正置于摆腿任务之上
    contactForce    2.5             ; 保留MPC支撑力计划，避免双腿交接时支撑力漂移
}

