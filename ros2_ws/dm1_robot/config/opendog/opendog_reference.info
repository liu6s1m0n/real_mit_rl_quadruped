targetDisplacementVelocity          0.5;
targetRotationVelocity              1.57;

comHeight                           0.32    ; 基座高度目标[m]（2026-11-05 由 0.28 提高：实机踏步时本来就站在约 0.32，站立只有 0.263，起步时机身上抬约 5 cm）
standUpDuration                     3.2

; 速度外环积分（2026-11-09 新增，gain 为 0 时关闭）：有平移命令时，在机体系积分 (命令速度 − 质心速度)，
; 叠加到给 MPC 的速度参考上，补偿持续的方向性偏差。11-09 22:26 实机：前进 18 cm/s 正常，
; 后退约 21、右移约 18（指令 18/15，偏快），左移只有约 10（偏慢）；原地 MPC 平均要 +8.5 N 向前力。
; 停止平移命令后按 leakTime 衰减到 0；原地踏步的回位仍由位置锚点负责。
; 高度积分（2026-11-10 新增，gain 为 0 时关闭）：站起爬升段之外，在所有模式积分 (comHeight − 机身高度)，叠加到高度目标。
; 11-10 实机：站起结束约 0.30 m，进入踏步未迈步 0.31，原地踏步 0.33，前进 0.34（目标都是 0.32）。
heightIntegral
{
  gain        0.5     ; 1/s
  limit       0.03    ; m
}

; 前进/后退俯仰前馈（2026-11-10 新增，0 关闭）：踏步时俯仰目标 = −pitchVelocityGain × 机体系前进命令速度，正俯仰为低头。
; 11-10 实机相对原地：前进 0.17 m/s 低头 +0.31°，后退 0.14 m/s 抬头 −0.48°，约 0.045 rad/(m/s)。
pitchVelocityGain   0.045

; 前进/后退高度前馈（2026-11-10 新增，0 关闭）：踏步时高度目标 −= heightVelocityGain × 机体系前进命令速度。
; 11-10 02:38 实机相对原地 0.322：前进（指令 0.18）0.332，后退（指令 0.15）0.309，约 0.07 m/(m/s)。
heightVelocityGain  0.07

velocityIntegral
{
  gain        0.0     ; 1/s（0 关闭）。11-09 实机 0.5：右移仍偏快、左移仍偏慢（偏差超过修正上限），且左移更晃，暂时关闭，改用 IMU roll 配平
  limit       0.05    ; m/s，每个轴的修正上限（仿真侧移本来就跟不上时，积满 0.06 会让侧移晃动增加约 20%，取 0.05）
  leakTime    0.5     ; s
}

