  (2,2)   100.0    ; 质心线速度z
  (3,3)   10.0     ; 归一化角动量x
  (4,4)   30.0     ; 归一化角动量y
  (5,5)   30.0     ; 归一化角动量z

  ;; 基座位姿权重 ;;
