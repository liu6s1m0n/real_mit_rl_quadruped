centroidalModelType             0      ; 动力学模型：0=完整质心，1=单刚体

hardware_output
{
  ; 原 OpenDog 统一增益为 kp=4、kd=5。
  ; 保留用户当前实测的统一 kp=20、kd=5。
  kp                  20.0
  kd                  5.0
}

legged_robot_interface
{
  verbose                               false  ; 是否打印加载的参数
}

model_settings
{
  positionErrorGain             0.0       ; 摆腿末端位置误差增益
  phaseTransitionStanceTime     0.1       ; 步态切换时的支撑过渡时间[s]

  verboseCppAd                  true      ; 是否打印CppAD信息
  recompileLibrariesCppAd       false     ; 是否重新编译CppAD库
  modelFolderCppAd              /tmp/legged_control/dm1_opendog_mjcf_mass14705035 ; CppAD库缓存目录
}

swing_trajectory_config
{
  liftOffVelocity               0.05      ; 抬脚初速度[m/s]
  touchDownVelocity            -0.1       ; 落脚末速度[m/s]
  swingHeight                   0.08      ; 摆腿抬脚高度[m]
  swingTimeScale                0.15      ; 短摆腿时间缩放阈值[s]
}

; DDP设置：连续时间最优控制求解
ddp
{
  algorithm                       SLQ       ; DDP算法类型

  nThreads                        3         ; 并行线程数
  threadPriority                  50        ; 线程优先级

  maxNumIterations                1         ; 最大迭代次数
  minRelCost                      1e-1      ; 最小相对代价下降
  constraintTolerance             5e-3      ; 约束容差

  displayInfo                     false     ; 是否打印详细信息
  displayShortSummary             false     ; 是否打印简要摘要
  checkNumericalStability         false     ; 是否检查数值稳定性
  debugPrintRollout               false     ; 是否打印轨迹展开调试信息
  debugCaching                    false     ; 是否打印缓存调试信息

  AbsTolODE                       1e-5      ; ODE绝对误差容差
  RelTolODE                       1e-3      ; ODE相对误差容差
  maxNumStepsPerSecond            10000     ; 每秒最大积分步数
  timeStep                        0.015     ; 积分时间步长[s]
  backwardPassIntegratorType      ODE45     ; 反向积分器

  constraintPenaltyInitialValue   20.0      ; 初始约束惩罚系数
  constraintPenaltyIncreaseRate   2.0       ; 惩罚系数增长倍率

  preComputeRiccatiTerms          true      ; 是否预计算Riccati项

  useFeedbackPolicy               false     ; 是否使用反馈策略

  strategy                        LINE_SEARCH ; 搜索策略
  lineSearch
  {
    minStepLength                 1e-2      ; 线搜索最小步长
    maxStepLength                 1.0       ; 线搜索最大步长
    hessianCorrectionStrategy     DIAGONAL_SHIFT ; Hessian修正方法
    hessianCorrectionMultiple     1e-5      ; Hessian修正强度
  }
}


; SQP设置：多重射击序列二次规划
sqp
{
  nThreads                              3         ; 并行线程数
  dt                                    0.015     ; 离散时间步长[s]
  sqpIteration                          1         ; SQP迭代次数
  deltaTol                              1e-4      ; 步长收敛阈值
  g_max                                 1e-2      ; 约束残差上限
  g_min                                 1e-6      ; 约束残差下限
  inequalityConstraintMu                0.1       ; 不等式约束屏障参数
  inequalityConstraintDelta             5.0       ; 不等式约束平滑参数
  projectStateInputEqualityConstraints  true      ; 是否投影等式约束
  printSolverStatistics                 true      ; 是否打印求解统计
  printSolverStatus                     false     ; 是否打印求解状态
  printLinesearch                       false     ; 是否打印线搜索信息
  useFeedbackPolicy                     false     ; 是否使用反馈策略
  integratorType                        RK2       ; 积分器类型
  threadPriority                        50        ; 线程优先级
}

; IPM设置：多重射击内点法
ipm
{
  nThreads                              3         ; 并行线程数
  dt                                    0.015     ; 离散时间步长[s]
  ipmIteration                          1         ; IPM迭代次数
  deltaTol                              1e-4      ; 步长收敛阈值
  g_max                                 10.0      ; 约束残差上限
  g_min                                 1e-6      ; 约束残差下限
  computeLagrangeMultipliers            true      ; 是否计算拉格朗日乘子
  printSolverStatistics                 true      ; 是否打印求解统计
  printSolverStatus                     false     ; 是否打印求解状态
  printLinesearch                       false     ; 是否打印线搜索信息
  useFeedbackPolicy                     false     ; 是否使用反馈策略
  integratorType                        RK2       ; 积分器类型
  threadPriority                        50        ; 线程优先级

  initialBarrierParameter               1e-4      ; 初始屏障参数
  targetBarrierParameter                1e-4      ; 目标屏障参数
  barrierLinearDecreaseFactor           0.2       ; 屏障参数线性衰减因子
  barrierSuperlinearDecreasePower       1.5       ; 屏障参数超线性衰减幂
  barrierReductionCostTol               1e-3      ; 代价下降触发阈值
  barrierReductionConstraintTol         1e-3      ; 约束下降触发阈值

  fractionToBoundaryMargin              0.995     ; 接近边界的最大步长比例
  usePrimalStepSizeForDual              false     ; 对偶变量是否沿用原始步长

  initialSlackLowerBound                1e-4      ; 初始松弛变量下界
  initialDualLowerBound                 1e-4      ; 初始对偶变量下界
  initialSlackMarginRate                1e-2      ; 初始松弛变量裕量
  initialDualMarginRate                 1e-2      ; 初始对偶变量裕量
}

; Rollout设置：数值积分轨迹
rollout
{
  AbsTolODE                       1e-5      ; ODE绝对误差容差
  RelTolODE                       1e-3      ; ODE相对误差容差
  timeStep                        0.015     ; 积分时间步长[s]
  integratorType                  ODE45     ; 积分器类型
  maxNumStepsPerSecond            10000     ; 每秒最大积分步数
  checkNumericalStability         false     ; 是否检查数值稳定性
}

mpc
{
  timeHorizon                     0.5  ; 预测时域[s]：减少SQP节点，缩短实机策略更新延迟
  solutionTimeWindow              -1   ; 求解时间上限[s]，-1=不限
  coldStart                       false     ; 是否每次冷启动

  debugPrint                      false     ; 是否打印MPC调试信息

  mpcDesiredFrequency             100  ; MPC频率[Hz]
  mrtDesiredFrequency             1000 ; MRT频率[Hz]（当前未使用）
}

